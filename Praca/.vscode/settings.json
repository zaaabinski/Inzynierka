{
    // Kompilacja pracy w rozszerzeniu LaTeX Workshop: pdflatex, biber, pdflatex, pdflatex (jak w README.md).
    // Domyślny przepis rozszerzenia używa latexmk, który w MiKTeX-u wymaga osobno zainstalowanego Perla.
    "latex-workshop.latex.recipes": [
        {
            "name": "Pełna kompilacja (pdflatex, biber, pdflatex, pdflatex)",
            "tools": ["pdflatex", "biber", "pdflatex", "pdflatex"]
        },
        {
            "name": "Szybki podgląd (jeden pdflatex, odwołania mogą być nieaktualne)",
            "tools": ["pdflatex"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "pdflatex",
            "command": "pdflatex",
            "args": ["-synctex=1", "-interaction=nonstopmode", "-file-line-error", "%DOC%"]
        },
        {
            "name": "biber",
            "command": "biber",
            "args": ["%DOCFILE%"]
        }
    ],
    "latex-workshop.latex.recipe.default": "first",
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.view.pdf.viewer": "tab"
}
